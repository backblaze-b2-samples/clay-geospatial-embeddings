# Backblaze B2 (required) — S3-compatible API, credentials only.
B2_APPLICATION_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
# Region slug for your bucket. The S3 endpoint is derived from this as
# https://s3.<B2_REGION>.backblazeb2.com — no endpoint is hardcoded in source.
B2_REGION=your_region

# Optional: public base URL for building direct object links. Only needed if
# the bucket is public; leave commented for a private bucket.
# B2_PUBLIC_URL_BASE=https://your-bucket.s3.us-west-004.backblazeb2.com

# Example of what filled-in values look like (fake — for visual reference only):
# B2_APPLICATION_KEY_ID=005EXAMPLE_NOT_A_REAL_KEY_ID
# B2_APPLICATION_KEY=one-long-secret-string-shown-once-on-create
# B2_BUCKET_NAME=my-geo-archive
# B2_REGION=us-west-004

# Optional: force the local Clay device. Autodetect order is CUDA -> Apple MPS
# -> CPU, defaulting to CPU. Values: auto | cpu | cuda | mps.
# CLAY_DEVICE=auto

# Frontend → API base URL. Defaults to http://localhost:8000 for local dev;
# set this to the deployed API origin in production (Next.js inlines it at
# build time, so it must be present when `pnpm build` runs).
# NEXT_PUBLIC_API_URL=https://your-api.example.com
