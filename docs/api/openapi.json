  "info": {
    "description": "Local API for Clay Geospatial Embeddings: run the Clay foundation model on satellite/aerial imagery tiles stored in Backblaze B2, write embedding tensors back to B2, and run k-NN similarity search over the archive. This contract documents the app's local API, not a hosted public endpoint.",
    "title": "Clay Geospatial Embeddings API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/files": {
      "get": {
        "operationId": "list_files_endpoint_files_get",
        "parameters": [
          {
            "in": "query",
            "name": "prefix",
            "required": false,
            "schema": {
              "default": "",
              "title": "Prefix",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/FileMetadata"
                  },
                  "title": "Response List Files Endpoint Files Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Files Endpoint",
        "tags": [
          "files"
        ]
      }
    },
